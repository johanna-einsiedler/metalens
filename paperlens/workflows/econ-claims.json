{
  "format": 1,
  "id": "econ-claims",
  "version": 1,
  "meta": {
    "title": "Claims in empirical economics papers",
    "tagline": "The claims a paper states and the results that carry them, transcribed by the pipeline, checked against the companion tables, reviewed, released.",
    "description": "The claims files of the Robustness-at-Scale pipeline enter a dataset through this workflow: uploaded into a run, re-checked against the declared contract, every cited point estimate checked against the cells of the companion tables dataset, every new claim reviewed, then released.",
    "hidden": true,
    "authors": [
      {
        "family": "Einsiedler",
        "given": "Johanna",
        "orcid": "0000-0002-6312-6861",
        "affiliation": "University of Basel; University of Copenhagen"
      }
    ],
    "keywords": [
      "claims",
      "regression tables",
      "cross-check",
      "economics"
    ],
    "license": "CC-BY-4.0",
    "brands": [
      "metalens"
    ]
  },
  "card": {
    "file": "econ-claims.card.md"
  },
  "dataset": {
    "unit": "paper",
    "key": "pdf_sha256"
  },
  "steps": [
    {
      "id": "claims",
      "kind": "extract",
      "label": "Claims and their results",
      "preset": "register-claims@f7387875",
      "source": "supplied",
      "review": {
        "mode": "all",
        "unit": "entry",
        "blocks": "release"
      }
    },
    {
      "id": "contract",
      "kind": "check",
      "label": "Contract check",
      "check": "schema",
      "over": [
        "claims"
      ],
      "on_fail": "note"
    },
    {
      "id": "links",
      "kind": "check",
      "label": "Estimates against the tables",
      "help": "each cited point estimate against the coefficient cells of the companion tables dataset; a resolved column with no matching cell is an error, an exhibit no column matches a warning",
      "check": "claims-vs-tables",
      "over": [
        "claims"
      ],
      "on_fail": "note",
      "severity": "error"
    },
    {
      "id": "edges",
      "kind": "derive",
      "label": "Corpus edges",
      "help": "one row per (cause, effect) concept pair across the corpus: a model call maps each claim's wording to a shared concept, a deterministic merge groups the claims into edges with their majority sign and the studies behind them",
      "over": "claims",
      "input": {
        "unit": "entries",
        "columns": [
          "claim_id",
          "cause",
          "effect",
          "cause_construct",
          "effect_construct",
          "sign",
          "statement",
          "_study"
        ],
        "filter": [
          {
            "column": "type",
            "op": "eq",
            "value": "edge"
          }
        ]
      },
      "identity": [
        "cause_concept",
        "effect_concept"
      ],
      "group_by": "_study",
      "calls": [
        {
          "id": "harmonise",
          "kind": "llm",
          "prompt": {
            "file": "econ-claims.edges.harmonise.md"
          }
        },
        {
          "id": "merge",
          "kind": "transform",
          "op": "group",
          "by": [
            "cause_concept",
            "effect_concept"
          ],
          "fields": {
            "n_claims": "count",
            "n_papers": "n_papers",
            "sign": "majority",
            "signs": {
              "op": "all",
              "column": "sign"
            },
            "studies": {
              "op": "union",
              "column": "_study"
            }
          }
        }
      ],
      "output": {
        "label": "Corpus edge",
        "fields": [
          {
            "name": "cause_concept",
            "type": "string",
            "required": true,
            "label": "Cause",
            "help": "the shared concept the claim's cause maps to (snake_case)"
          },
          {
            "name": "effect_concept",
            "type": "string",
            "required": true,
            "label": "Effect",
            "help": "the shared concept the claim's effect maps to"
          },
          {
            "name": "sign",
            "type": "enum",
            "options": [
              "+",
              "-",
              "0",
              "mixed"
            ],
            "label": "Sign",
            "help": "per claim as stated; per edge the majority across its claims"
          },
          {
            "name": "n_claims",
            "type": "integer",
            "label": "Claims",
            "help": "how many claims the edge rests on"
          },
          {
            "name": "n_papers",
            "type": "integer",
            "label": "Papers",
            "help": "how many articles state it"
          },
          {
            "name": "signs",
            "type": "list",
            "label": "Signs stated",
            "help": "every claim's sign, in order"
          },
          {
            "name": "studies",
            "type": "list",
            "label": "Studies",
            "help": "the articles, as first author and year"
          }
        ]
      },
      "review": {
        "mode": "all",
        "unit": "entry",
        "blocks": "release"
      }
    },
    {
      "id": "release",
      "kind": "release",
      "label": "Release",
      "gate": [
        "claims",
        "edges"
      ]
    }
  ]
}
