{
  "format": 2,
  "id": "masem-indirect",
  "version": 2,
  "meta": {
    "title": "MASEMiner — indirect information",
    "tagline": "Extract item-level factor loadings, inter-factor correlations, and study metadata for any target scale (MASEM, indirect)",
    "description": "Indirect-information variant: item-level factor loadings and inter-factor correlations (plus study/sample metadata) for a psychometric scale across primary factor-analytic studies. Generic across scales — you name the scale and its items in the builder. Use it when a paper reports the measurement model rather than the effect sizes themselves; the sibling direct-information variant extracts pairwise effect sizes.",
    "mode": "extraction",
    "hidden": true,
    "authors": [
      {"family": "Schroeders", "given": "Ulrich", "orcid": "0000-0002-5225-1122", "affiliation": "University of Kassel"},
      {"family": "Gnambs", "given": "Timo", "orcid": "0000-0002-6984-1276", "affiliation": "Leibniz Institute for Educational Trajectories (LIfBi), Bamberg"},
      {"family": "Einsiedler", "given": "Johanna", "orcid": "0000-0002-6312-6861", "affiliation": "University of Basel; University of Copenhagen"}
    ],
    "keywords": ["meta-analysis", "MASEM", "factor analysis", "factor loadings", "measurement model", "psychometrics"],
    "license": "CC-BY-4.0",
    "evaluated_with": [
      {"model": "gpt-5.6-sol", "mode": "extraction", "note": "the four use cases and the verification study of Schroeders, Gnambs & Einsiedler (2026); September 2026"}
    ],
    "related": [
      {"kind": "paper", "title": "MASEMiner – AI-assisted data extraction for meta-analytic structural equation modeling (earlier version as a preprint)", "doi": "10.31234/osf.io/dceqs_v1", "role": "describes and validates this preset"},
      {"kind": "supplement", "title": "Evaluation materials: prompts, codebooks, reference databases, MASEMiner exports and analysis scripts (Harvard Dataverse; DOI to be added on publication)"},
      {"kind": "repository", "title": "Metalens engine", "url": "https://github.com/johanna-einsiedler/metalens"},
      {"kind": "repository", "title": "MASEMiner distribution (local install)", "url": "https://github.com/johanna-einsiedler/maseminer"},
      {"kind": "website", "title": "Hosted MASEMiner", "url": "https://metalens.tech/maseminer"},
      {"kind": "preset", "title": "MASEMiner — direct information", "id": "masem-direct"},
      {"kind": "funding", "title": "Deutsche Forschungsgemeinschaft (DFG), project 546292646, Priority Programme SPP 2317 META-REP; University of Copenhagen Lighthouse grant \"Scaling Scientific Synthesis\" (129339)"}
    ]
  },
  "card": {
    "file": "masem-indirect.card.md"
  },
  "prompt": {
    "file": "masem-indirect.prompt.md",
    "params": {
      "scale_name": {
        "type": "string",
        "label": "Scale name",
        "help": "the instrument this extraction targets",
        "default": "the target instrument"
      },
      "n_items": {
        "type": "integer",
        "label": "Number of items",
        "default": null
      },
      "item_texts": {
        "type": "list",
        "numbered": true,
        "label": "Item texts",
        "help": "verbatim item texts in order, so the model matches reordered or paraphrased items",
        "default": []
      }
    },
    "generate": []
  },
  "paper": {
    "fields": []
  },
  "entries": {
    "key": "samples",
    "label": "Sample",
    "help": "one visibly distinct analyzed sample/group with its own item-level loadings; never a merged or alternative solution",
    "cardinality": "many",
    "id_field": "sample_id",
    "title": "Sample {sample_id}",
    "evidence": "row",
    "fields": [
      {
        "name": "sample_id",
        "type": "string",
        "required": true,
        "label": "Sample id",
        "help": "the paper's own group label; sample1, sample2, … when unclear",
        "evidence": "row"
      },
      {
        "name": "factor_loadings",
        "type": "table",
        "label": "Factor loadings",
        "evidence": "table",
        "confidence": "factor_loadings",
        "help": "one row per (item, factor) cell of the selected solution",
        "columns": [
          {
            "name": "item",
            "type": "integer",
            "label": "Item",
            "help": "printed item number"
          },
          {
            "name": "factor",
            "type": "string",
            "label": "Factor",
            "help": "F1, F2, … by printed position"
          },
          {
            "name": "loading",
            "type": "number",
            "label": "Loading",
            "range": [
              -1,
              1
            ],
            "help": "as printed; null when not reported"
          }
        ]
      },
      {
        "name": "factor_correlations",
        "type": "table",
        "label": "Factor correlations",
        "evidence": "table",
        "confidence": "factor_correlations",
        "help": "one row per unique off-diagonal factor pair, ascending",
        "columns": [
          {
            "name": "factor_a",
            "type": "string",
            "label": "Factor A"
          },
          {
            "name": "factor_b",
            "type": "string",
            "label": "Factor B"
          },
          {
            "name": "r",
            "type": "number",
            "label": "r",
            "range": [
              -1,
              1
            ],
            "help": "latent correlation; null when not reported"
          }
        ]
      },
      {
        "name": "country",
        "type": "string",
        "label": "Country",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "lang",
        "type": "string",
        "label": "Language",
        "help": "language of the administered scale",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "n",
        "type": "integer",
        "label": "N",
        "help": "sample size for this sample/group only",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "female",
        "type": "number",
        "label": "% female",
        "range": [
          0,
          100
        ],
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "age",
        "type": "number",
        "label": "Mean age",
        "help": "in years, one decimal",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "nfac",
        "type": "integer",
        "label": "Retained factors",
        "help": "after empty-factor removal",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "cfa",
        "type": "enum",
        "label": "Analysis type",
        "evidence": "row",
        "confidence": "metadata",
        "options": [
          {
            "value": 0,
            "label": "exploratory (EFA-based)"
          },
          {
            "value": 1,
            "label": "confirmatory (CFA-based)"
          }
        ]
      },
      {
        "name": "met",
        "type": "enum",
        "label": "Estimation method",
        "evidence": "row",
        "confidence": "metadata",
        "options": [
          {
            "value": 1,
            "label": "principal component analysis (PCA)"
          },
          {
            "value": 2,
            "label": "principal axis factoring (PAF)"
          },
          {
            "value": 3,
            "label": "maximum likelihood (ML)"
          },
          {
            "value": 4,
            "label": "other (ULS, WLSMV, GLS, Bayesian …) — name it in notes"
          }
        ]
      },
      {
        "name": "notes",
        "type": "text",
        "label": "Notes",
        "help": "ambiguities, ignored alternatives, factor-label mapping, suppression thresholds",
        "evidence": "none"
      }
    ],
    "children": []
  },
  "confidence": {
    "levels": [
      "high",
      "medium",
      "low"
    ],
    "notes": true,
    "groups": [
      {
        "id": "factor_loadings",
        "label": "Factor loadings",
        "scope": "entry",
        "help": "the item-level loading table for this sample"
      },
      {
        "id": "factor_correlations",
        "label": "Factor correlations",
        "scope": "entry",
        "help": "the unique off-diagonal factor-correlation values"
      },
      {
        "id": "metadata",
        "label": "Sample metadata",
        "scope": "entry",
        "help": "country, n, female, age, cfa, met, nfac, lang"
      }
    ]
  },
  "display": {
    "tabs": [
      {
        "id": "loadings",
        "label": "Factor loadings",
        "fields": [
          "factor_loadings"
        ]
      },
      {
        "id": "correlations",
        "label": "Correlations",
        "fields": [
          "factor_correlations"
        ]
      },
      {
        "id": "descriptives",
        "label": "Descriptives",
        "fields": [
          "sample_id",
          "country",
          "lang",
          "n",
          "female",
          "age",
          "nfac",
          "cfa",
          "met",
          "notes"
        ]
      }
    ],
    "entries": "cards",
    "grid_rows": "entries",
    "triage": "low_confidence_first",
    "paper_panel": "open",
    "locate": {
      "factor_loadings": {
        "anchor_column": "item",
        "anchor_param": "item_texts"
      },
      "factor_correlations": {}
    },
    "audit": {
      "factor_loadings": {
        "key": [
          "item",
          "factor"
        ]
      },
      "factor_correlations": {
        "key": [
          "factor_a",
          "factor_b"
        ]
      }
    },
    "citation_flash": false,
    "analysis": {
      "default_unit": "factor_loadings",
      "roles": {
        "item": [
          "identifier",
          "dimension"
        ],
        "factor": [
          "dimension"
        ]
      }
    }
  }
}
