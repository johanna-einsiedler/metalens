{
  "format": 2,
  "id": "genai-work-routed",
  "version": 4,
  "meta": {
    "title": "GenAI at work — routed — v4",
    "tagline": "Routed papers: every flag resolved by a coder.",
    "description": "The routed workflow of the validation: the papers whose record contradicts an inclusion criterion, that a coder flagged for full review, or whose headline estimates the checks and the runs flag; every flag listed and resolved. Taxonomy schema b5ed1ca67c; codebook in labeling/codebook.md.",
    "mode": "import",
    "hidden": false,
    "brands": [
      "metalens"
    ]
  },
  "prompt": {
    "text": "",
    "params": {}
  },
  "paper": {
    "fields": [
      {
        "name": "r_reasons",
        "type": "text",
        "label": "Why this paper is here",
        "evidence": "none"
      },
      {
        "name": "r_flags",
        "type": "table",
        "label": "Flags",
        "help": "everything flagged on this paper, grouped by unit; resolve each row",
        "evidence": "none",
        "columns": [
          {
            "name": "group",
            "type": "string",
            "label": "Unit"
          },
          {
            "name": "estimate_id",
            "type": "string",
            "label": "Estimate"
          },
          {
            "name": "kind",
            "type": "enum",
            "label": "Kind",
            "options": [
              "check_fail",
              "check_warn",
              "unstable",
              "criterion",
              "coder_flag"
            ]
          },
          {
            "name": "code",
            "type": "string",
            "label": "Code"
          },
          {
            "name": "message",
            "type": "text",
            "label": "What was flagged"
          },
          {
            "name": "source",
            "type": "string",
            "label": "Source"
          },
          {
            "name": "extracted",
            "type": "string",
            "label": "Extracted value"
          },
          {
            "name": "verdict",
            "type": "enum",
            "label": "Verdict",
            "options": [
              "model_right",
              "corrected",
              "cannot_tell",
              "keep_paper",
              "exclude_paper",
              "not_applicable"
            ],
            "help": "model_right = the extracted value stands; corrected = give the right value; cannot_tell = the paper does not settle it; keep_paper / exclude_paper = for a criterion row, the decision on the paper; not_applicable = the flag does not apply"
          },
          {
            "name": "corrected_value",
            "type": "string",
            "label": "Corrected value"
          },
          {
            "name": "note",
            "type": "string",
            "label": "Note"
          }
        ]
      },
      {
        "name": "notes",
        "type": "text",
        "label": "Notes",
        "evidence": "none",
        "help": "anything worth recording about this paper: a doubt, a rule you applied, a place to look at again"
      },
      {
        "name": "evidence_items",
        "type": "table",
        "label": "Evidence",
        "evidence": "none",
        "columns": [
          {
            "name": "n",
            "type": "integer",
            "label": "No.",
            "required": true
          },
          {
            "name": "page",
            "type": "integer",
            "label": "Page"
          },
          {
            "name": "kind",
            "type": "enum",
            "label": "Kind",
            "options": [
              "passage",
              "table"
            ],
            "required": true
          },
          {
            "name": "text",
            "type": "text",
            "label": "Text",
            "verbatim": true,
            "help": "the passage verbatim; for a table its caption and rows as markdown"
          },
          {
            "name": "note",
            "type": "string",
            "label": "Note"
          },
          {
            "name": "bears_on",
            "type": "list",
            "label": "Bears on"
          }
        ]
      }
    ]
  },
  "entries": {
    "key": "review",
    "label": "Paper",
    "help": "one per paper; the done button and the full-review flag",
    "cardinality": "one",
    "id_field": "review_id",
    "title": "{review_id}",
    "evidence": "none",
    "fields": [
      {
        "name": "review_id",
        "type": "string",
        "label": "Review",
        "evidence": "none"
      },
      {
        "name": "full_review",
        "type": "enum",
        "label": "Full review needed",
        "evidence": "none",
        "options": [
          {
            "value": "no",
            "label": "no"
          },
          {
            "value": "yes",
            "label": "yes"
          }
        ],
        "help": "yes when what you saw makes the whole extraction of this paper doubtful; say why"
      },
      {
        "name": "full_review_why",
        "type": "string",
        "label": "Why",
        "evidence": "none"
      }
    ]
  },
  "display": {
    "entries": "cards",
    "paper_panel": "open",
    "review": {
      "layout": "stages",
      "items": "evidence_items",
      "verify": "paper",
      "stages": [
        {
          "id": "resolve",
          "label": "Resolve",
          "paper_fields": [
            "r_reasons",
            "r_flags",
            "notes"
          ],
          "fields": [
            "full_review",
            "full_review_why"
          ],
          "help": "This paper was routed for the reasons above. Each row is one flag: a check an estimate failed (its source and the extracted value given), a cell the runs disagree on, a criterion the record contradicts, or a coder's flag. Open the source in the PDF and give a verdict; for a corrected value, write it as printed. A criterion row takes keep_paper or exclude_paper. Press done when every row has a verdict."
        }
      ]
    }
  }
}
