{
  "format": 2,
  "id": "masem-direct",
  "version": 2,
  "meta": {
    "title": "MASEMiner — direct information",
    "tagline": "Extract the effect sizes a paper reports directly — correlations in the text or in a table — with the sample and study metadata a Meta-Analytic SEM needs. Its companion, MASEMiner — indirect information, covers papers that report the measurement model instead.",
    "description": "Direct-information variant: pairwise effect sizes (with reliability + instrument metadata) per sample, plus coded sample metadata. Use it when papers report the effect sizes themselves — correlation matrices, prose-reported correlations, other bivariate statistics. The sibling indirect-information variant extracts factor loadings and inter-factor correlations instead.",
    "mode": "extraction",
    "hidden": false
  },
  "prompt": {
    "file": "masem-direct.prompt.md",
    "params": {
      "effect_sizes": {
        "type": "table",
        "columns": [
          "code",
          "label"
        ],
        "label": "Effect sizes",
        "help": "canonical effect-size codes to extract (one per line: code: label)",
        "default": [
          {
            "code": "r",
            "label": "Correlation"
          },
          {
            "code": "or",
            "label": "Odds ratios"
          }
        ],
        "empty": "(no canonical effect sizes defined — extract any reported pairwise effect size)"
      },
      "variables": {
        "type": "table",
        "columns": [
          "name",
          "definition",
          "synonyms"
        ],
        "label": "Variables",
        "help": "canonical variable codes with a definition; everything else is ignored",
        "default": [],
        "empty": "(no variables defined — extract every reported pairwise effect size)"
      },
      "variable_rules": {
        "type": "text",
        "label": "Eligibility rules",
        "help": "which pairs of variables count (replaces the default 'Extract ONLY these canonical variables. IGNORE all other variables.')",
        "default": null,
        "empty": "Extract ONLY these canonical variables.\n\nIGNORE all other variables."
      },
      "variable_guidance": {
        "type": "text",
        "label": "Mapping guidance",
        "help": "typical informants, instruments, things to ignore, and examples of mapping a paper's measure to a canonical code",
        "default": null,
        "block": true
      }
    },
    "generate": []
  },
  "paper": {
    "fields": []
  },
  "entries": {
    "key": "samples",
    "label": "Sample",
    "help": "an analytically distinct group (independent cohort, subgroup, wave); not robustness checks or repeated mentions of the same participants",
    "cardinality": "many",
    "id_field": "sample_id",
    "title": "Sample {sample_id}",
    "evidence": "row",
    "fields": [
      {
        "name": "sample_id",
        "type": "string",
        "required": true,
        "label": "Sample id",
        "help": "the paper's own label for the sample, e.g. 'Study 1 – adolescents'",
        "evidence": "row"
      },
      {
        "name": "pubyear",
        "type": "integer",
        "label": "Publication year",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "country",
        "type": "string",
        "label": "Country",
        "help": "country of the sample",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "continent",
        "type": "string",
        "label": "Continent",
        "evidence": "row",
        "confidence": "metadata"
      },
      {
        "name": "lang",
        "type": "string",
        "label": "Language",
        "help": "language of respondents",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "pubtype",
        "type": "enum",
        "label": "Publication type",
        "evidence": "row",
        "confidence": "metadata",
        "options": [
          {
            "value": 1,
            "label": "journal article"
          },
          {
            "value": 2,
            "label": "book"
          },
          {
            "value": 3,
            "label": "thesis/dissertation"
          },
          {
            "value": 4,
            "label": "proceedings/presentation"
          },
          {
            "value": 5,
            "label": "other"
          }
        ]
      },
      {
        "name": "female",
        "type": "number",
        "label": "% female",
        "range": [
          0,
          100
        ],
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "age",
        "type": "number",
        "label": "Mean age",
        "help": "in years",
        "evidence": "value",
        "confidence": "metadata"
      },
      {
        "name": "clinical",
        "type": "enum",
        "label": "Clinical status",
        "evidence": "value",
        "confidence": "metadata",
        "options": [
          {
            "value": 0,
            "label": "nonclinical sample"
          },
          {
            "value": 1,
            "label": "clinical sample"
          },
          {
            "value": 2,
            "label": "mixed clinical/nonclinical sample"
          }
        ]
      },
      {
        "name": "notes",
        "type": "text",
        "label": "Notes",
        "help": "anything a coder must know: other reported reliabilities, exclusions, ambiguities",
        "evidence": "none"
      }
    ],
    "children": [
      {
        "key": "records",
        "label": "Effect size",
        "help": "one explicitly reported zero-order association between two canonical variables",
        "title": "{var1} – {var2}",
        "evidence": "row",
        "layout": "table",
        "fields": [
          {
            "name": "var1",
            "type": "enum",
            "options": "${variables}",
            "required": true,
            "label": "Variable 1",
            "help": "canonical code of the first variable (alphabetical order)",
            "evidence": "row",
            "confidence": "effect_sizes"
          },
          {
            "name": "var2",
            "type": "enum",
            "options": "${variables}",
            "required": true,
            "label": "Variable 2",
            "help": "canonical code of the second variable",
            "evidence": "row",
            "confidence": "effect_sizes"
          },
          {
            "name": "desc1",
            "type": "string",
            "label": "Operationalisation 1",
            "help": "how the paper measured var1",
            "evidence": "row"
          },
          {
            "name": "desc2",
            "type": "string",
            "label": "Operationalisation 2",
            "help": "how the paper measured var2",
            "evidence": "row"
          },
          {
            "name": "es",
            "type": "number",
            "required": true,
            "label": "Effect size",
            "range": [
              -1,
              1
            ],
            "help": "the reported statistic, exactly as printed",
            "evidence": "value",
            "confidence": "effect_sizes"
          },
          {
            "name": "type",
            "type": "enum",
            "options": "${effect_sizes}",
            "required": true,
            "label": "Effect-size type",
            "evidence": "row",
            "confidence": "effect_sizes"
          },
          {
            "name": "n",
            "type": "integer",
            "label": "N",
            "help": "sample size for this statistic",
            "evidence": "value",
            "confidence": "effect_sizes"
          },
          {
            "name": "rel1",
            "type": "number",
            "label": "Reliability 1",
            "range": [
              0,
              1
            ],
            "help": "reliability of var1 in this sample",
            "evidence": "value",
            "confidence": "reliabilities"
          },
          {
            "name": "rel2",
            "type": "number",
            "label": "Reliability 2",
            "range": [
              0,
              1
            ],
            "help": "reliability of var2 in this sample",
            "evidence": "value",
            "confidence": "reliabilities"
          },
          {
            "name": "rel1_type",
            "type": "enum",
            "label": "Reliability type 1",
            "options": [
              "alpha",
              "omega",
              "icc",
              "kappa",
              "other"
            ],
            "evidence": "row",
            "confidence": "reliabilities"
          },
          {
            "name": "rel2_type",
            "type": "enum",
            "label": "Reliability type 2",
            "options": [
              "alpha",
              "omega",
              "icc",
              "kappa",
              "other"
            ],
            "evidence": "row",
            "confidence": "reliabilities"
          },
          {
            "name": "instr1",
            "type": "string",
            "label": "Instrument 1",
            "help": "instrument measuring var1",
            "evidence": "row"
          },
          {
            "name": "instr2",
            "type": "string",
            "label": "Instrument 2",
            "help": "instrument measuring var2",
            "evidence": "row"
          }
        ]
      }
    ]
  },
  "confidence": {
    "levels": [
      "high",
      "medium",
      "low"
    ],
    "notes": true,
    "groups": [
      {
        "id": "effect_sizes",
        "label": "Effect sizes",
        "scope": "entry",
        "help": "correct var1/var2 mapping and correct numeric values"
      },
      {
        "id": "reliabilities",
        "label": "Reliabilities",
        "scope": "entry",
        "help": "rel1/rel2 and their types"
      },
      {
        "id": "metadata",
        "label": "Sample metadata",
        "scope": "entry",
        "help": "the sample metadata block"
      }
    ]
  },
  "display": {
    "tabs": [
      {
        "id": "effectsizes",
        "label": "Effect sizes",
        "fields": [
          "records"
        ]
      },
      {
        "id": "descriptives",
        "label": "Descriptives",
        "fields": [
          "sample_id",
          "pubyear",
          "country",
          "continent",
          "lang",
          "pubtype",
          "female",
          "age",
          "clinical",
          "notes"
        ]
      }
    ],
    "entries": "cards",
    "grid_rows": "records",
    "triage": "low_confidence_first",
    "paper_panel": "open",
    "citation_flash": false,
    "locate": {
      "records": {
        "anchor_fields": [
          "desc1",
          "desc2"
        ]
      }
    },
    "analysis": {
      "default_unit": "records",
      "derived": [
        {
          "name": "es_ci",
          "label": "Effect size",
          "formula": "r_ci_fisher",
          "unit": "records",
          "inputs": {
            "r": "es",
            "n": "n"
          },
          "when": {
            "column": "type",
            "in": [
              "r"
            ]
          }
        }
      ],
      "units": {
        "by": "type",
        "columns": [
          "es"
        ]
      }
    }
  }
}
