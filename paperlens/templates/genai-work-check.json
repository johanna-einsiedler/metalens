{
  "format": 1,
  "id": "genai-work-check",
  "version": 1,
  "meta": {
    "title": "GenAI at work — extraction check",
    "tagline": "One exhibit of the paper, every cited cell as printed against the unit it was read into; the cells the extraction missed added.",
    "description": "The extraction-check pass of the GenAI-at-work validation as a review template over the pipeline's record: the drawn exhibit as the head, its transcribed cells beneath with the estimate each fed, a verdict on value and mapping per cell, a row for every cell the extraction missed, and a full-review flag for the paper.",
    "brands": [
      "metalens"
    ]
  },
  "for": "genai-work-extraction",
  "layout": "stages",
  "items": "evidence_items",
  "verify": "paper",
  "plants": {"share": 0.33, "seed": "check-plants-v1", "kinds": ["value", "mapping"]},
  "stages": [
    {
      "id": "cells",
      "label": "Cells",
      "help": "One exhibit of this paper, drawn at random among those the extraction read estimates from, laid out as a table from its transcription; the pane and its page tag show it in the PDF. Compare the two. Click a value that is not exactly as printed (it is listed below: type it as printed), a mapping that is wrong (the outcome, subgroup, arms or horizon a cell is read into — shown once where it holds for several cells; a click flags every cell it covers), or a cell of this exhibit that estimates an AI-versus-reference contrast and is not cited (it is added below: give the estimate it should feed, or leave that blank). Then press *Everything else correct*, set *Full review needed* when what you saw makes the paper's whole extraction doubtful, and press done.",
      "blocks": [
        {
          "unit": "paper_metadata.exhibits",
          "label": "The exhibit",
          "only_sampled": true,
          "show": [
            "exhibit_id",
            "kind",
            "page",
            "caption",
            "panels",
            "n_cells",
            "n_cited"
          ],
          "title": "{exhibit_id} · {caption}"
        },
        {
          "unit": "paper_metadata.exhibit_cells",
          "label": "Its cells",
          "where": {
            "exhibit_id": {
              "sampled": "exhibits.exhibit_id"
            }
          },
          "show": [
            "panel",
            "row_label",
            "column",
            "value_as_printed",
            "se_as_printed",
            "estimate_id",
            "estimand_text",
            "role"
          ],
          "layout": "flags",
          "columns": [
            {"label": "Cell", "fields": ["row_label", "column", "panel"]},
            {"label": "As printed", "fields": ["value_as_printed", "se_as_printed"]},
            {"label": "Estimate", "fields": ["estimate_id", "estimand_text", "role"], "wide": true}
          ],
          "grid": {"of": "exhibit_id", "panel": "panel", "row": "row_label", "column": "column", "value": "value_as_printed", "tip": "{estimate_id} · {estimand_text}",
                   "flag": {"question": "value_ok", "answer": "no"},
                   "mapping": {"field": "estimand_text", "sep": " · ", "question": "mapping_ok", "answer": "no", "note": "note"}},
          "confirm": {"label": "Everything else correct", "answers": {"value_ok": "yes", "mapping_ok": "yes"}, "paper": {"full_review": "no"}},
          "questions": [
            {
              "name": "value_ok",
              "type": "enum",
              "label": "Value right?",
              "help": "is the value (and SE) exactly what the exhibit prints in that cell?",
              "options": [
                {
                  "value": "yes"
                },
                {
                  "value": "no"
                },
                {
                  "value": "unsure"
                }
              ],
              "required": true
            },
            {
              "name": "mapping_ok",
              "type": "enum",
              "label": "Mapping right?",
              "help": "is this cell an estimate of that unit (those arms, that outcome, subgroup and horizon)?",
              "options": [
                {
                  "value": "yes"
                },
                {
                  "value": "no"
                },
                {
                  "value": "unsure"
                }
              ],
              "required_when": {
                "estimate_id": {
                  "not_null": true
                }
              }
            },
            {
              "name": "note",
              "type": "string",
              "label": "Note"
            }
          ],
          "add": {
            "label": "a cell the extraction missed",
            "fields": [
              {
                "name": "panel",
                "type": "string",
                "label": "Panel"
              },
              {
                "name": "row_label",
                "type": "string",
                "label": "Row"
              },
              {
                "name": "column",
                "type": "string",
                "label": "Column"
              },
              {
                "name": "value_as_printed",
                "type": "string",
                "label": "Value as printed"
              },
              {
                "name": "estimate_id",
                "type": "string",
                "label": "Estimate",
                "help": "the estimate the cell should have fed, when there is one"
              }
            ]
          }
        },
        {
          "unit": "paper",
          "label": "This paper",
          "show": [],
          "questions": [
            {
              "name": "full_review",
              "type": "enum",
              "label": "Full review needed",
              "help": "yes when what you saw makes the whole extraction of this paper doubtful; say why",
              "options": [
                {
                  "value": "no",
                  "label": "no"
                },
                {
                  "value": "yes",
                  "label": "yes"
                }
              ],
              "required": true
            },
            {
              "name": "full_review_why",
              "type": "string",
              "label": "Why"
            }
          ]
        }
      ]
    }
  ]
}
