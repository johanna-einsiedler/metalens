# Copy to .env (gitignored) and fill in for local dev. Loaded by scripts/dev.sh.
# Nothing here is required to run — the app works with own-API-key mode and
# sensible localhost defaults. Set the credit vars to test server-paid runs.

# --- Server-paid credit runs (optional) ---------------------------------------
# The model a keyless "Use my Metalens credits" run uses, plus the provider key
# it is charged against. Without BOTH, the credit toggle stays hidden.
PAPERLENS_CREDIT_MODEL=gemini-3.5-flash
PAPERLENS_GOOGLE_KEY=
# PAPERLENS_OPENAI_KEY=
# PAPERLENS_ANTHROPIC_KEY=

# --- Overrides (defaults shown — usually leave commented) ---------------------
# PAPERLENS_DATABASE_URL=dbname=paperlens
# PAPERLENS_REDIS_URL=redis://localhost:6379
# PAPERLENS_STORAGE=local
# PAPERLENS_HOST=127.0.0.1
# PAPERLENS_PORT=8000

# ── product surfaces ────────────────────────────────────────────────────────────
# Pin the brand for a local run (the hosted app picks it from the hostname):
# PAPERLENS_BRAND=maseminer
# Extra hostname patterns → brand (semicolon-separated entries, comma-separated hosts):
# PAPERLENS_BRAND_HOSTS="maseminer=maseminer.example.org,*.maseminer.example.org"
# Extra preset directories (os.pathsep-separated), loaded next to the built-ins:
# PAPERLENS_PRESET_DIRS=~/.maseminer/presets

# ── logged-out retention / free trial ───────────────────────────────────────────
# PAPERLENS_ANON_RETENTION_MINUTES=120     # delete an idle anonymous session's uploads after this
# PAPERLENS_ANON_TRIAL_PER_IP_DAY=5        # free-trial runs per network per day

# ── required in production (S3 storage or secure cookies), optional in dev ──────
# PAPERLENS_SECRET=$(openssl rand -hex 32)
